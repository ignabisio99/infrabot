# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=infrabot
POSTGRES_PORT=5432

# Adminer (visor web de Postgres)
ADMINER_PORT=8082

# Backend Configuration (FastAPI)
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://user:password@db:5432/infrabot

# Frontend Configuration (React)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Email (Gmail SMTP)
SMTP_EMAIL=tu_email@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
APP_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=tu_access_token_de_meta
WHATSAPP_PHONE_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=infrabot-verify-token

# Motor de IA (mock por defecto; openai/gemini requieren OPENAI_API_KEY)
# AI_PROVIDER: mock | openai | ollama
# OPENAI_API_KEY: también sirve para la API key de Gemini
# OPENAI_MODEL: gpt-4o-mini (OpenAI) | gemini-3.5-flash-lite (Gemini)
# AI_BASE_URL: prefijo hasta antes de /chat/completions
#   OpenAI: https://api.openai.com/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# AI_SSL_VERIFY=false  # solo si hay proxy corporativo con cert self-signed

# Ollama local (AI_PROVIDER=ollama). No usa API key ni las variables OPENAI_*/AI_BASE_URL.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_REASONING_EFFORT=none  # Gemma 4 razona por defecto: ~7x más lento

# Inflación IPC (INDEC) — API Series de Tiempo datos.gob.ar
INFLACION_API_URL=https://apis.datos.gob.ar/series/api/series/
INFLACION_SERIE_ID=101.1_I2NG_2016_M_22

# Duplicados semánticos: el LLM (ej. Gemini) evalúa TODOS los reclamos abiertos de la
# misma escuela para detectar el mismo problema aunque esté redactado distinto.
# Requiere AI_PROVIDER != mock. Recomendado ON para detección robusta.
AI_DUPLICADOS_SEMANTICOS=true

# WhatsApp conversacional IA (opt-in, comando/botón "libre"). Default off.
AI_WHATSAPP=false

# STT de audios de WhatsApp.
# AI_PROVIDER=mock → devuelve AI_STT_MOCK_TEXTO sin llamar APIs.
# Gemini → API nativa generateContent (AI_GEMINI_NATIVE_URL); OpenAI → /audio/transcriptions (AI_STT_MODEL).
AI_STT_MODEL=whisper-1
AI_GEMINI_NATIVE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_STT_MOCK_TEXTO=Escuela Técnica N°1, baño del primer piso: pérdida de agua.

# referencia_costo: placeholders + sync desde presupuestos (POST /ai/referencias/sync).
# Reemplazable por históricos reales del Consejo.

# Redis (cola de webhooks WhatsApp). En Docker: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Seguimiento a contratistas (CU-05). Horas sin aviso antes de recordar.
SEGUIMIENTO_HORAS=48
SEGUIMIENTO_INTERVALO_SEGUNDOS=900

# ngrok (túnel para webhook de WhatsApp)
NGROK_AUTHTOKEN=tu_ngrok_authtoken
NGROK_DOMAIN=tu-dominio.ngrok-free.dev

# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=infrabot
POSTGRES_PORT=5432

# Backend Configuration (FastAPI)
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://user:password@db:5432/infrabot

# Frontend Configuration (React)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Email (Gmail SMTP)
SMTP_EMAIL=tu_email@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
APP_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=tu_access_token_de_meta
WHATSAPP_PHONE_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=infrabot-verify-token

# Motor de IA (mock por defecto; openai/gemini requieren OPENAI_API_KEY)
# AI_PROVIDER: mock | openai
# OPENAI_API_KEY: también sirve para la API key de Gemini
# AI_BASE_URL: prefijo hasta antes de /chat/completions
#   OpenAI: https://api.openai.com/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# AI_SSL_VERIFY=false  # solo si hay proxy corporativo con cert self-signed

# Inflación IPC (INDEC) — API Series de Tiempo datos.gob.ar
INFLACION_API_URL=https://apis.datos.gob.ar/series/api/series/
INFLACION_SERIE_ID=101.1_I2NG_2016_M_22

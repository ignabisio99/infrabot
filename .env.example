# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=infrabot
POSTGRES_PORT=5432

# Adminer (visor web de Postgres)
ADMINER_PORT=8082

# Backend Configuration (FastAPI)
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://user:password@db:5432/infrabot

# Frontend Configuration (React)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Email (Gmail SMTP)
# En desarrollo los mails van a Mailpit (http://localhost:8025) salvo que definas
# SMTP_HOST=smtp.gmail.com y SMTP_PORT=587.
SMTP_EMAIL=tu_email@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
APP_URL=http://localhost:3000
# Orígenes extra para CORS, separados por coma. Ej. para probar desde el celular en la
# misma red: CORS_EXTRA_ORIGINS=http://192.168.x.x:3000 (con VITE_API_URL apuntando a
# esa IP; mientras tanto, en la compu también entrar por la IP y no por localhost).
CORS_EXTRA_ORIGINS=

# Google OAuth
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# Clave con la que se firman las sesiones y los links de los emails. Obligatoria en
# producción (si falta, el backend no arranca). Generala con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# En desarrollo puede quedar vacía. Cambiarla cierra todas las sesiones abiertas.
SECRET_KEY=

# WhatsApp Cloud API (Meta). Obligatorios en producción. En desarrollo dejalos vacíos: así
# los envíos se simulan; con cualquier otro valor se llama a Meta y falla.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Lo inventás vos y lo cargás igual en Meta al dar de alta el webhook. Sin valor, el alta falla.
WHATSAPP_VERIFY_TOKEN=un_valor_largo_y_aleatorio
# Meta > tu app > Configuración de la app > Básica > Clave secreta de la app. Con ella se
# verifica que cada mensaje del webhook venga de Meta; sin ella se rechazan todos.
WHATSAPP_APP_SECRET=tu_app_secret_de_meta

# Motor de IA (mock por defecto; openai/gemini requieren OPENAI_API_KEY)
# AI_PROVIDER: mock | openai | ollama
# OPENAI_API_KEY: también sirve para la API key de Gemini
# OPENAI_MODEL: gpt-4o-mini (OpenAI) | gemini-3.5-flash-lite (Gemini)
# AI_BASE_URL: prefijo hasta antes de /chat/completions
#   OpenAI: https://api.openai.com/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# AI_SSL_VERIFY=false  # solo si hay proxy corporativo con cert self-signed

# Ollama local (AI_PROVIDER=ollama). No usa API key ni las variables OPENAI_*/AI_BASE_URL.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_REASONING_EFFORT=none  # Gemma 4 razona por defecto: ~7x más lento

# Inflación IPC (INDEC) — API Series de Tiempo datos.gob.ar
INFLACION_API_URL=https://apis.datos.gob.ar/series/api/series/
INFLACION_SERIE_ID=101.1_I2NG_2016_M_22

# Duplicados semánticos: el LLM (ej. Gemini) evalúa TODOS los reclamos abiertos de la
# misma escuela para detectar el mismo problema aunque esté redactado distinto.
# Requiere AI_PROVIDER != mock. Recomendado ON para detección robusta.
AI_DUPLICADOS_SEMANTICOS=true

# WhatsApp conversacional IA (opt-in, comando/botón "libre"). Default off.
AI_WHATSAPP=false

# STT: el audio no se guarda, solo queda el texto.
# AI_STT_PROVIDER: mock | local | openai | gemini
#   (vacío = mock si AI_PROVIDER=mock, si no Whisper local / faster-whisper)
# local: Whisper en esta máquina o un server en AI_STT_BASE_URL.
AI_STT_PROVIDER=local
AI_STT_LOCAL_MODEL=small
AI_STT_MODEL_DIR=/models/faster-whisper
# AI_STT_BASE_URL=http://host.docker.internal:9000/v1
AI_STT_MODEL=whisper-1
AI_GEMINI_NATIVE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_STT_MOCK_TEXTO=Escuela Técnica N°1, baño del primer piso: pérdida de agua.

# referencia_costo: placeholders + sync desde presupuestos (POST /ai/referencias/sync).
# Reemplazable por históricos reales del Consejo.

# Redis (cola de webhooks WhatsApp). En Docker: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Seguimiento a contratistas (CU-05). Horas tras entrar en ejecución antes de la primera
# pregunta "¿terminaste?". Luego el ritmo lo marca el tiempo estimado del contratista.
SEGUIMIENTO_HORAS=24
SEGUIMIENTO_INTERVALO_SEGUNDOS=900

# Chat con operador (WhatsApp)
CONVERSACION_MEDIA_TTL_DIAS=7
CONVERSACION_MEDIA_MAX_MB=16
CONVERSACION_LIMPIEZA_INTERVALO_SEGUNDOS=21600
CONVERSACION_ESPERA_AVISO_MIN=15
CONVERSACION_INACTIVIDAD_HORAS=4

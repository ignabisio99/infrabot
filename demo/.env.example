POSTGRES_USER=infrabot
POSTGRES_PASSWORD=
POSTGRES_DB=infrabot
DATABASE_URL=postgresql+psycopg://infrabot:<POSTGRES_PASSWORD>@db:5432/infrabot

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_URL=https://<maquina>.<tailnet>.ts.net:10000
COOKIE_SECURE=true
# Vacío oculta el botón de Google: el client ID no tiene autorizado el dominio de Funnel.
GOOGLE_CLIENT_ID=
# Vacíos: los mails no se mandan.
SMTP_EMAIL=
SMTP_PASSWORD=

# De la app de Meta propia (número de prueba). El token, de un usuario del sistema:
# el temporal vence a las 24 h.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Gemini por API: la notebook no da para un LLM local.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_GEMINI_NATIVE_URL=https://generativelanguage.googleapis.com/v1beta
AI_DUPLICADOS_SEMANTICOS=true
AI_WHATSAPP=false
# gemini en vez de local: Whisper con 2 núcleos tarda varios segundos por audio.
AI_STT_PROVIDER=gemini
AI_STT_LOCAL_MODEL=small
AI_STT_MODEL_DIR=/models/faster-whisper

INFLACION_API_URL=https://apis.datos.gob.ar/series/api/series/
INFLACION_SERIE_ID=101.1_I2NG_2016_M_22

REDIS_URL=redis://redis:6379/0

SEGUIMIENTO_HORAS=24
SEGUIMIENTO_INTERVALO_SEGUNDOS=900
CONVERSACION_MEDIA_TTL_DIAS=7
CONVERSACION_MEDIA_MAX_MB=16
CONVERSACION_LIMPIEZA_INTERVALO_SEGUNDOS=21600
CONVERSACION_ESPERA_AVISO_MIN=15
CONVERSACION_INACTIVIDAD_HORAS=4

# Puerto local al que apunta Funnel.
DEMO_PORT=8088

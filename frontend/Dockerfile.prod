# Imagen de producción del frontend.
# Etapa 1: buildea el bundle estático con Vite.
# Etapa 2: lo sirve con Nginx (liviano, sin Node en runtime).

# ----- Etapa build -----
FROM node:24-alpine AS build

RUN corepack enable \
 && corepack prepare pnpm@10.13.1 --activate

WORKDIR /app

# Instalar dependencias con la lockfile (build reproducible).
COPY package.json pnpm-lock.yaml* ./
# HUSKY=0 evita que el hook "prepare" (husky) rompa el install en CI.
ENV HUSKY=0
RUN pnpm install --frozen-lockfile

COPY . .

# Vite hornea las variables VITE_* EN ESTE PASO. Llegan como build-args desde
# el workflow de GitHub Actions y se exponen como env para `pnpm build`.
ARG VITE_API_URL
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN pnpm build

# ----- Etapa runtime -----
FROM nginx:1.27-alpine AS runtime

# Config de nginx para SPA (fallback a index.html en rutas de React Router).
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiar el build estático generado en la etapa anterior.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
